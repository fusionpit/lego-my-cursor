<Window x:Class="LeGoMyCursor.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LeGo My Cursor" Icon="legomycursor.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="{DynamicResource BodySize}" Foreground="{DynamicResource Text}" Background="{DynamicResource Background}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Grid x:Name="Client" Width="600" Height="450" Background="{DynamicResource Background}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="58"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ModeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,0">
        <TextBlock Text="Choose your fix mode" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold" MinHeight="36"/>
        <TextBlock x:Name="ModeStatus" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"/>
        <TextBlock x:Name="ModeHelp" Margin="0,8,0,0" MinHeight="36" Foreground="{DynamicResource Muted}"/>
        <StackPanel x:Name="ModeRows" Margin="0,10,0,0" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        <StackPanel x:Name="ModeLinks" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="ReinstallButton" Style="{StaticResource LinkButton}" MinWidth="92" Content="Reinstall" Click="OnReinstall"/>
          <Button x:Name="UninstallButton" Style="{StaticResource LinkButton}" MinWidth="92" Foreground="{DynamicResource Danger}" Content="Uninstall" Margin="10,0,0,0" Click="OnUninstall"/>
          <Button x:Name="ModeLog" Style="{StaticResource LinkButton}" Content="Open log folder" Margin="10,0,0,0" Click="OnLog"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="StatusPanel" Margin="24,0,24,16" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition x:Name="StatusTopRow" Height="214"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="StatusSymbol" Width="96" Height="96" VerticalAlignment="Top" Margin="0,88,0,0" IsHitTestVisible="False">
        <Grid x:Name="Spinner" Width="64" Height="64" Visibility="Collapsed" AutomationProperties.Name="Working">
          <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="6" Margin="3"/>
          <Path x:Name="SpinnerArc" Data="M 32,3 A 29,29 0 0 1 60,39" Stroke="{DynamicResource Accent}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
          </Path>
        </Grid>
        <Grid x:Name="SuccessGlyph" Width="64" Height="64" Visibility="Collapsed" AutomationProperties.Name="Complete">
          <Ellipse Fill="{DynamicResource Success}"/>
          <Path Data="M 15,33 L 28,45 L 49,21" Stroke="{DynamicResource SuccessText}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
        <Viewbox x:Name="StatusGlyph" Width="48" Height="48"><Path x:Name="StatusPath" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
      </Grid>
      <TextBlock x:Name="Heading" Grid.Row="1" TextAlignment="Center" FontSize="{DynamicResource HeadingSize}" FontWeight="SemiBold" MinHeight="40"/>
      <ScrollViewer x:Name="DetailScroll" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
        <StackPanel>
          <TextBlock x:Name="Stage" FontSize="{DynamicResource StageSize}" TextAlignment="Center" Margin="0,0,0,20" Visibility="Collapsed"/>
          <TextBlock x:Name="Detail" TextAlignment="Center" Foreground="{DynamicResource Muted}"/>
          <TextBlock x:Name="Caution" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,22,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Footer}">
      <Grid Margin="24,0"><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>
        <Button x:Name="FooterLog" Style="{StaticResource LinkButton}" Content="Open log folder" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnLog"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="OnPrimary"/>
          <Button x:Name="SecondaryButton" MinWidth="116" Margin="16,0,0,0" Click="OnSecondary"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
