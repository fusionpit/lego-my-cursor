<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:Double x:Key="BodySize">13.333</sys:Double><sys:Double x:Key="HeadingSize">26.667</sys:Double>
  <sys:Double x:Key="TitleSize">14.667</sys:Double><sys:Double x:Key="StageSize">16</sys:Double>
  <SolidColorBrush x:Key="Background" Color="White"/><SolidColorBrush x:Key="Surface" Color="White"/>
  <SolidColorBrush x:Key="Selected" Color="#EDF6FF"/><SolidColorBrush x:Key="Text" Color="#141B27"/>
  <SolidColorBrush x:Key="Muted" Color="#4A5768"/><SolidColorBrush x:Key="Border" Color="#D2D8E0"/>
  <SolidColorBrush x:Key="Accent" Color="#005FB8"/><SolidColorBrush x:Key="Primary" Color="#0067D2"/>
  <SolidColorBrush x:Key="PrimaryText" Color="White"/><SolidColorBrush x:Key="Footer" Color="#F6F7F9"/>
  <SolidColorBrush x:Key="Danger" Color="#B91C1C"/><SolidColorBrush x:Key="Warning" Color="#9D6600"/>
  <SolidColorBrush x:Key="Success" Color="#23A639"/><SolidColorBrush x:Key="SuccessText" Color="White"/>
  <SolidColorBrush x:Key="SelectedText" Color="#141B27"/><SolidColorBrush x:Key="SelectedMuted" Color="#4A5768"/>
  <SolidColorBrush x:Key="SelectedAccent" Color="#005FB8"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Focus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="4" Stroke="{DynamicResource Text}" StrokeDashArray="1,2" StrokeThickness="1"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontSize" Value="{DynamicResource TitleSize}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="4,2"/><Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style x:Key="ModeRadio" TargetType="RadioButton">
    <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
        <Grid>
          <Ellipse x:Name="Ring" Width="20" Height="20" Stroke="{DynamicResource Muted}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,17,0,0"/>
          <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource SelectedAccent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,22,0,0" Visibility="Collapsed"/>
          <ContentPresenter Margin="55,10,12,8"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter Property="Foreground" Value="{DynamicResource SelectedText}"/><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SelectedAccent}"/>
          <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
