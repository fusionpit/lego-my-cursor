#include <winver.h>

#ifndef VER_MAJOR
#define VER_MAJOR 0
#define VER_MINOR 0
#define VER_PATCH 0
#define VER_BUILD 1
#endif

#define VER_STR2(x) #x
#define VER_STR(x) VER_STR2(x)
#define VER_DOTTED VER_STR(VER_MAJOR.VER_MINOR.VER_PATCH.VER_BUILD)

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DRV
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LeGo My Cursor contributors"
            VALUE "FileDescription", "LeGo My Cursor touchpad filter (UMDF 2)"
            VALUE "FileVersion", VER_DOTTED
            VALUE "InternalName", "legomycursor"
            VALUE "LegalCopyright", "LeGo My Cursor contributors"
            VALUE "OriginalFilename", "legomycursor.dll"
            VALUE "ProductName", "LeGo My Cursor"
            VALUE "ProductVersion", VER_DOTTED
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
